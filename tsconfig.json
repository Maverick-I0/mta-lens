{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "./webapp",
    "outDir": "./dist",
    "paths": {
      "com/app/mtalens/*": ["./webapp/*"],
      "unit/*": ["./webapp/test/unit/*"],
      "integration/*": ["./webapp/test/integration/*"]
    },
    "types": [
      "@sapui5/types"
    ]
  },
  "include": [
    "./webapp/**/*"
  ]
}
