{
  "compilerOptions": {
    "target": "esnext",
    "module": "es2022",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "bundler",
    "rootDir": "./webapp",
    "outDir": "./dist",
    "paths": {
      "com/app/mtalens/*": [
        "./webapp/*"
      ],
      "unit/*": [
        "./webapp/test/unit/*"
      ],
      "integration/*": [
        "./webapp/test/integration/*"
      ]
    },
    "types": [
      "@sapui5/types"
    ]
  },
  "include": [
    "./webapp/**/*"
  ]
}