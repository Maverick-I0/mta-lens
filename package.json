{
  "name": "mtalens",
  "version": "0.0.1",
  "description": "An SAP Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.11.0",
    "@sap/ux-ui5-tooling": "1.33.0",
    "@sapui5/types": "~1.152.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@ui5/cli": "^4.0.69",
    "eslint": "^10.11.0",
    "eslint-plugin-fiori-custom": "2.6.7",
    "typescript": "^7.0.2",
    "ui5-tooling-transpile": "^3.13.1",
    "typedoc": "^0.28.0"
  },
  "scripts": {
    "start": "fiori run --open \"test/flp.html#app-preview\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "ui5 build self-contained --all --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint ./",
    "ts-typecheck": "tsc --noEmit",
    "prestart": "npm run ts-typecheck",
    "prebuild": "npm run ts-typecheck",
    "deploy": "fiori verify",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open \"/index.html?sap-ui-xx-viewCache=false\"",
    "int-test": "fiori run --open \"test/integration/opaTests.qunit.html\"",
    "start-variants-management": "fiori run --open \"/preview.html#app-preview\"",
    "unit-test": "fiori run --open \"test/unit/unitTests.qunit.html\"",
    "test:unit": "echo 'Headless QUnit execution requires Karma/UI5-Test-Runner setup' && exit 0",
    "test:integration": "echo 'Headless OPA5 execution requires Karma/UI5-Test-Runner setup' && exit 0",
    "docs:ci": "typedoc --out docs src/"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "sapux": [],
  "allowScripts": {
    "ui5-tooling-transpile@3.13.1": true
  }
}
